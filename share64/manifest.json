{
  "name": "share64",
  "short_name": "share64",
  "start_url": "/share64/",
  "scope": "/share64/",
  "display": "standalone",
  "background_color": "#ffffff",
  "description": "Convert images to Base64 and view Base64 images.",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share64/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["image/*"]
        }
      ],
      "text": "text"
    }
  }
}